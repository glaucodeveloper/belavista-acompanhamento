{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "belavista-cloudflare-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-08-29",
  "d1_databases": [
    {
      "binding": "BELAVISTA_DB",
      "database_name": "belavista-db",
      "database_id": "replace-me"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "BELAVISTA_INGEST_QUEUE",
        "queue": "belavista-ingest"
      }
    ],
    "consumers": [
      {
        "queue": "belavista-ingest",
        "max_batch_size": 10,
        "max_batch_timeout": 30
      }
    ]
  },
  "vars": {
    "BELAVISTA_PUBLIC_BASE_URL": "https://belavista.example.workers.dev",
    "BELAVISTA_GITHUB_REPO": "usuario/belavista-ai-monitor",
    "BELAVISTA_GITHUB_BRANCH": "main",
    "NVIDIA_API_URL": "https://integrate.api.nvidia.com/v1/chat/completions",
    "NVIDIA_VLM_MODEL": "meta/llama-3.2-90b-vision-instruct",
    "NVIDIA_REASONING_MODEL": "@cf/nvidia/nemotron-3-120b-a12b"
  }
}
