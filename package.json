{
  "name": "alianca-park-desktop",
  "version": "1.0.4",
  "description": "Estação operacional e atendimento assistido do Aliança Park.",
  "author": "Aliança Park",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "desktopName": "alianca-park-desktop",
  "scripts": {
    "deps:install": "npm ci",
    "deps:install:capacitor": "npm ci --prefix mobile/capacitor",
    "deps:install:firebase": "npm install --prefix firebase-functions",
    "deps:install:wails": "go -C desktop/wails mod download",
    "deps:install:all": "npm run deps:install && npm run deps:install:capacitor && npm run deps:install:firebase && npm run deps:install:wails",
    "start": "npm run build:frontend && node server.mjs",
    "proxy:local": "node scripts/local-port-proxy.mjs",
    "desktop:start": "npm run build:frontend && electron .",
    "desktop:check": "node --check electron/main.mjs && node --check electron/preload.cjs && node --check desktop/instagram-bridge.mjs",
    "desktop:gateway:cloudflare": "node scripts/start-desktop-cloudflare-gateway.mjs",
    "desktop:package": "npm run build:frontend && electron-builder --linux AppImage --config.directories.output=desktop-release",
    "desktop:package:win": "npm run build:frontend && node scripts/package-desktop-win.mjs",
    "test:desktop": "node --test --test-concurrency=1 tests/desktop/*.test.mjs",
    "instagram:bridge": "npx @askjo/camofox-browser",
    "build:frontend": "tsc -p frontend/tsconfig.json",
    "test:frontend:live": "npm run build:frontend && node scripts/verify-frontend-sales-history-live.mjs",
    "test:frontend:materials:live": "npm run build:frontend && node scripts/verify-frontend-materials-live.mjs",
    "test:frontend:agenda:live": "npm run build:frontend && node scripts/verify-frontend-agenda-live.mjs",
    "test:frontend:activities:live": "npm run build:frontend && node scripts/verify-frontend-activities-live.mjs",
    "test:frontend:progress:live": "npm run build:frontend && node scripts/verify-frontend-progress-live.mjs",
    "test:frontend:control:live": "npm run build:frontend && node scripts/verify-frontend-control-live.mjs",
    "test:frontend:cash-record:live": "npm run build:frontend && node scripts/verify-frontend-cash-record-live.mjs",
    "build:public": "npm run build:frontend && node scripts/build-stage-knowledge.mjs && node scripts/build-public-pages.mjs",
    "twa:admin:init": "npx --yes @bubblewrap/cli init --manifest=https://belavista-3f887.web.app/admin-twa-manifest.webmanifest --directory=mobile/twa/android-admin",
    "twa:admin:build": "cd mobile/twa/android-admin && npx --yes @bubblewrap/cli build",
    "capacitor:install": "npm run deps:install:capacitor",
    "capacitor:sync": "npm --prefix mobile/capacitor run cap:sync",
    "capacitor:apk": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-capacitor-apk.ps1",
    "public:preview": "node server.mjs",
    "check:worker": "node --check worker/src/index.js && node --check worker/src/routes.js && node --check worker/src/nvidia.js && node --check worker/src/workflows.js",
    "worker:deploy": "npx wrangler deploy --config worker/wrangler.jsonc",
    "test:worker": "node --test worker/test/*.test.js",
    "test:autonomy:study": "node --test tests/autonomy/cash-master-trigger-study.test.mjs",
    "test:purchase:mock": "node --test --test-concurrency=1 tests/autonomy/mock-purchase-agenda-propagation.test.mjs",
    "test:online": "node worker/test/online-infrastructure.mjs",
    "library:check": "node --check belavista-ui/src/system.js && node --check belavista-ui/src/components.js && node --check belavista-ui/catalog.js",
    "test:screen": "playwright test",
    "test:interface:business": "playwright test --config=playwright.business.config.mjs",
    "test:chat": "node --test tests/admin/worker-context-chat-v5407.test.mjs",
    "test:public-map": "node --test tests/public-leads/satellite-ground-only-v5408.test.mjs tests/public-leads/native-road-pavers-v5378.test.mjs tests/public-leads/generated-aerial-trees-v5388.test.mjs tests/public-leads/satellite-mosaic-fallback-v5386.test.mjs tests/public-leads/static-capture-no-maps-v5561.test.mjs",
    "video:check": "cd video/product-intro && npm run check",
    "video:render": "cd video/product-intro && npm run render -- --quality high --output output/product-intro.mp4",
    "test:screen:ui": "playwright test --ui",
    "build:demo": "node scripts/build-demo.mjs",
    "check:demo": "node --check worker/src/operational-loop.js && node --check worker/src/github-store.js && node --check worker/src/live-test-session.js && node --check worker/src/request-auth.js && node --check worker/src/github-session-store.js && node --check worker/src/routes.js",
    "test:demo:cli": "node scripts/test-demo-cli.mjs",
    "test:live": "node worker/test/live/obra-completa.live.mjs",
    "test:live:story": "bash scripts/run-live-e2e.sh .",
    "test:demo": "npm run test:live:story",
    "test:real:source": "node --test tests/real/source-contract.test.mjs",
    "test:real:live": "node --test --test-concurrency=1 tests/real/live-readonly.test.mjs tests/real/operational-loop-live.test.mjs",
    "test:real:write": "node --test --test-concurrency=1 tests/real/write-integration-live.test.mjs",
    "test:real": "npm run test:real:source && npm run test:real:live",
    "test:real:mock": "node --test --test-concurrency=1 tests/real/mock-domain.test.mjs tests/real/mock-worker-contract.test.mjs",
    "test:real:all": "npm run test:real:source && npm run test:real:mock && npm run test:real:live",
    "test:inference:source": "node --test tests/inference/01-contract-source.test.mjs worker/test/strict-nvidia-state.test.js",
    "test:system": "node --test tests/system/initial-to-delivery-certification.test.mjs",
    "test:admin:production-mock": "node --test --test-concurrency=1 tests/admin/production-auth-thematic-flows-v1.test.mjs",
    "test:admin:foreman-surface": "node --test --test-concurrency=1 tests/admin/foreman-reduced-surface-v1.test.mjs",
    "test:admin:proposal-vision": "node --test --test-concurrency=1 tests/admin/proposal-vision-inference-v1.test.mjs",
    "test:visual-suite": "node --test tests/visual/system-flow-suite.test.mjs",
    "test:visual:operational": "playwright test --config=playwright.operational-visual.config.mjs",
    "test:map-filters": "node --test tests/admin/map-multi-layer-filters-v1.test.mjs",
    "test:inference:real": "node --test --test-concurrency=1 tests/inference/02-initial-state.test.mjs tests/inference/03-meta-counterfactual.test.mjs tests/inference/04-cash-and-provision.test.mjs tests/inference/05-receipts-material-propagation.test.mjs tests/inference/06-field-diary-continuation.test.mjs tests/inference/07-stage-unlock-chain.test.mjs tests/inference/08-personnel-locality.test.mjs tests/inference/09-event-matrix.test.mjs tests/inference/10-full-journey.test.mjs",
    "test:inference:application": "node --env-file-if-exists=.env tests/inference/application-state.run.mjs",
    "test:inference:write": "node --test --test-concurrency=1 tests/inference/11-realtime-commit.test.mjs",
    "test:inference:all": "npm run test:inference:source && npm run test:inference:real",
    "test:inference:enabled": "npm run test:inference:source && npm run test:inference:real",
    "test:inference:dry": "npm run test:inference:source",
    "test:inference:full": "npm run test:inference:source && npm run test:inference:real && npm run test:inference:write",
    "test:inference": "node --env-file-if-exists=.env --test tests/inference",
    "test:cases": "node --test tests/cases",
    "test:headless": "playwright test --workers=1 --reporter=line",
    "test:sequences": "npm run test:inference && npm run test:cases && npm run test:headless",
    "test:operational": "node --test tests/operational/cases.test.mjs tests/operational/openjev-client-fallback.test.mjs",
    "test:operational:live": "node --test tests/operational/openjev-live.test.mjs",
    "system-model:once": "node desktop/system-model/daemon.mjs --once",
    "system-model:daemon": "node desktop/system-model/daemon.mjs",
    "test:operational:reality": "node --test --test-concurrency=1 tests/operational/reality-live.test.mjs",
    "test:operational:registry-read": "node --test --test-concurrency=1 tests/operational/registry-read-reality.test.mjs",
    "test:operational:reality:all": "node --test --test-concurrency=1 tests/operational/reality-live.test.mjs tests/operational/registry-read-reality.test.mjs",
    "system-model:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/system-model/install-openjev.ps1",
    "system-model:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/system-model/start-openjev.ps1",
    "system-model:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/system-model/stop-openjev.ps1",
    "system-model:health": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/system-model/health-openjev.ps1",
    "test:operational:obra:jornada": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/operational/whole-work-journey.live.test.mjs",
    "test:operational:obra:preflight": "node --env-file-if-exists=.env tests/operational/whole-work-preflight.mjs",
    "test:operational:obra:jornada:full": "npm run test:operational:obra:preflight && npm run test:operational:obra:jornada",
    "test:record-ocr:live": "node --env-file-if-exists=.env --test --test-concurrency=1 tests/operational/record-ocr-fixtures.live.test.mjs",
    "fixtures:stage-progress:ocr": "node --env-file-if-exists=.env scripts/build-stage-progress-ocr-fixtures.mjs",
    "test:stage-progress:ocr:live": "npm run fixtures:stage-progress:ocr && node --env-file-if-exists=.env --test --test-concurrency=1 tests/operational/stage-progress-ocr-matrix.live.test.mjs",
    "test:record-ocr:ui": "playwright test tests/screen/record-ocr-dynamic-v21.spec.mjs --workers=1",
    "test:system-model:natural-reliability": "node --env-file-if-exists=.env tests/operational/run-system-model-natural-reliability.mjs",
    "test:system-model:natural": "node --env-file-if-exists=.env tests/operational/run-system-model-natural-reliability.mjs",
    "test:cert:chat-record-attachment": "node --env-file-if-exists=.env --test tests/operational/chat-record-attachment-properties.cert.test.mjs",
    "test:record-ocr:ui:cert": "playwright test tests/screen/chat-record-attachment-properties.cert-v36.spec.mjs --workers=1"
  },
  "build": {
    "appId": "br.com.aliancapark.desktop",
    "productName": "Aliança Park Desktop",
    "icon": "assets/public/alianca-park-logo-full-letter-cutouts-v555.png",
    "asar": false,
    "files": [
      "**/*",
      "!**/.env*",
      "!**/.git",
      "!**/.git/**/*",
      "!**/.belavista-*",
      "!**/.belavista-*/**/*",
      "!**/.tokensave",
      "!**/.tokensave/**/*",
      "!**/.gemini",
      "!**/.gemini/**/*",
      "!**/.agents",
      "!**/.agents/**/*",
      "!**/.codex",
      "!**/.codex/**/*",
      "!backups/**/*",
      "!data/**/*",
      "!desktop-release/**/*",
      "!docs/**/*",
      "!mobile/**/*",
      "!output/**/*",
      "!dist-pages/**/*",
      "!test-results/**/*",
      "!tests/**/*",
      "!**/test/**/*",
      "!**/tests/**/*",
      "!tmp/**/*",
      "!video/**/*",
      "!**/*.log",
      "!**/*.zip",
      "!**/*.sqlite*",
      "!eng.traineddata",
      "!release-artifacts/**/*",
      "!dist/**/*",
      "dist/frontend/**/*",
      "docs/ai-construction-operational-playbook.md",
      "data/development-seed.json",
      "data/ocr-models/**/*"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "synopsis": "Estação operacional Aliança Park"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aliança Park Desktop",
      "uninstallDisplayName": "Aliança Park Desktop",
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "extraResources": [
      {
        "from": "desktop-runtime-config.json",
        "to": "desktop-runtime-config.json"
      }
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/three": "^0.186.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "hyperframes": "^0.8.31",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@capacitor/local-notifications": "^8.3.1",
    "firebase-admin": "^14.3.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.186.1",
    "unpdf": "^1.9.1"
  }
}
