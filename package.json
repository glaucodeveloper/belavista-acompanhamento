{
  "name": "alianca-park-rebuild",
  "version": "2.0.1",
  "description": "Aliança Park — acompanhamento de obras, lotes e repasses",
  "author": "Aliança Park",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "electron:hmr": "node scripts/electron-hmr.mjs",
    "dev": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "cap:sync": "npm run build && cap sync",
    "cap:open:android": "cap open android",
    "cap:run:android": "npm run cap:sync && cap run android",
    "profile:adb:logs": "node scripts/profile-adb-logcat.mjs",
    "test:inference:allocation": "node scripts/test-inference-allocation.mjs",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "user:create": "node scripts/create-user.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "electron": "44.2.0",
    "electron-builder": "^26.18.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^1.64.0",
    "motion": "^14.7.1",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.61.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5",
    "wrangler": "4.155.0"
  },
  "build": {
    "appId": "com.aliancapark.desktop",
    "productName": "Aliança Park",
    "asar": true,
    "directories": {
      "output": "release/windows"
    },
    "files": [
      "electron/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Alianca-Park-${version}-${arch}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
