# Escolha: nvidia (NVIDIA API Catalog) ou gemini (Google AI Studio).
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
# Perfil inicial de baixa latência para chat operacional.
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# Alternativa Gemini (use AI_PROVIDER=gemini para ativar).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
PORT=8080
HOST=0.0.0.0
BELAVISTA_API_BASE=
BELAVISTA_PUBLIC_BASE_URL=

# Autorização operacional. Em produção, use firebase para validar ID tokens
# com claims role=owner|admin|foreman.
BELAVISTA_AUTH_MODE=demo
BELAVISTA_DEMO_ROLE=owner
# Em localhost, este e-mail recebe o perfil TI · Desenvolvimento após login
# Firebase. Nunca habilita esse perfil em ngrok, Hosting ou outro domínio.
BELAVISTA_LOCAL_DEVELOPER_EMAILS=icaroglaucooliveira@gmail.com
FIREBASE_DATABASE_URL=https://belavista-3f887-default-rtdb.firebaseio.com
# Prefira GOOGLE_APPLICATION_CREDENTIALS apontando para um arquivo fora do repo.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_WEB_PUSH_VAPID_KEY=
# Somente desenvolvimento local. Em Firebase Functions configure o segredo
# NVIDIA_API_KEY pelo Firebase CLI/Secret Manager, nunca em Hosting.
FIREBASE_PROJECT_ID=belavista-3f887

# Cloudflare Worker / V10
NVIDIA_VLM_MODEL=meta/llama-3.2-90b-vision-instruct
NVIDIA_REASONING_MODEL=@cf/nvidia/nemotron-3-120b-a12b
