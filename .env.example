# Escolha: nvidia (NVIDIA API Catalog) ou gemini (Google AI Studio).
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
# Perfil inicial de baixa latência para chat operacional.
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_RECORD_OCR_MODEL=meta/llama-3.2-11b-vision-instruct
# Rota multimodal dedicada do chat administrativo; o NIM recebe text + image_url.
NVIDIA_REASONING_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_REASONING_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_REASONING_MAX_TOKENS=4096
NVIDIA_REASONING_BUDGET=2048

# Alternativa Gemini (use AI_PROVIDER=gemini para ativar).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
PORT=8080
HOST=0.0.0.0
BELAVISTA_API_BASE=
BELAVISTA_PUBLIC_BASE_URL=

# Autorização operacional. A API e as páginas exigem Firebase ID tokens
# com claims de role/userType; demo fica reservado ao loopback de desenvolvimento.
BELAVISTA_AUTH_MODE=firebase
BELAVISTA_DEMO_ROLE=owner
# Em localhost, este e-mail recebe o perfil TI · Desenvolvimento após login
# Firebase. Nunca habilita esse perfil em ngrok, Hosting ou outro domínio.
BELAVISTA_LOCAL_DEVELOPER_EMAILS=icaroglaucooliveira@gmail.com
FIREBASE_DATABASE_URL=https://belavista-3f887-default-rtdb.firebaseio.com
# Prefira GOOGLE_APPLICATION_CREDENTIALS apontando para um arquivo fora do repo.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_WEB_PUSH_VAPID_KEY=
# Somente desenvolvimento local. Em Firebase Functions configure o segredo
# NVIDIA_API_KEY pelo Firebase CLI/Secret Manager, nunca em Hosting.
FIREBASE_PROJECT_ID=belavista-3f887

# Cloudflare Worker / V10
NVIDIA_VLM_MODEL=meta/llama-3.2-90b-vision-instruct
NVIDIA_REASONING_MODEL=@cf/nvidia/nemotron-3-120b-a12b

# Meta Messaging API — configure as Worker secrets, never commit values.
INSTAGRAM_ACCESS_TOKEN=
# Alias aceito para o token de acesso do Instagram (não é o Client Token do App).
CLIENT_ACCESS_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_GRAPH_VERSION=v25.0
INSTAGRAM_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
