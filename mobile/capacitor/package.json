{
  "name": "alianca-park-capacitor",
  "version": "1.0.8",
  "private": true,
  "description": "Shell Android Capacitor da aplicação Aliança Park.",
  "scripts": {
    "assets:generate": "capacitor-assets generate --android --iconBackgroundColor \"#07111f\" --iconBackgroundColorDark \"#07111f\"",
    "web:build": "node ../../scripts/build-capacitor-web.mjs",
    "cap:add:android": "cap add android",
    "cap:sync": "npm run assets:generate && npm run web:build && cap sync android",
    "android:open": "cap open android",
    "android:debug": "cap run android",
    "android:apk": "cd android && gradlew.bat assembleDebug",
    "android:release": "cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "8.5.2",
    "@capacitor/local-notifications": "^8.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.5.2"
  },
  "allowScripts": {
    "sharp@0.32.6": true
  }
}
