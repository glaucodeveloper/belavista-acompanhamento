{
  "functions": [{"source": "firebase-functions", "codebase": "automation", "ignore": ["node_modules", ".git", "firebase-debug.log"]}],
  "hosting": {
    "public": "dist-pages",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {"source": "**/*.@(js|mjs|css)", "headers": [{"key": "Cache-Control", "value": "public,max-age=3600"}]},
      {"source": "dist/frontend/*.js", "headers": [{"key": "Cache-Control", "value": "public,max-age=0,must-revalidate"}]}
    ],
    "rewrites": [
      {"source": "/leads", "destination": "/public-leads.html"},
      {"source": "/leads/**", "destination": "/public-leads.html"},
      {"source": "/docs", "destination": "/docs/index.html"},
      {"source": "/admin/workers", "destination": "/admin-workers.html"},
      {"source": "/admin/workers/**", "destination": "/admin-workers.html"},
      {"source": "**", "destination": "/index.html"}
    ]
  },
  "database": {"rules": "firebase.database.rules.json"},
  "storage": {"rules": "firebase.storage.rules"}
}
