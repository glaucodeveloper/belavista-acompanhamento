package dev.ruby.model

import com.getcapacitor.JSObject
import com.getcapacitor.Plugin
import com.getcapacitor.PluginCall
import com.getcapacitor.annotation.CapacitorPlugin

// Bridge contract for the Android llama.cpp binding.
// Wire this class to ggml-org/llama.cpp examples/llama.android's AiChat /
// InferenceEngine. The web/Ruby layer only sees RubyPlatform.model.
@CapacitorPlugin(name = "RubyModel")
class RubyModelPlugin : Plugin() {
    @PluginMethod
    fun load(call: PluginCall) {
        call.reject("Attach llama.cpp Android AiChat/InferenceEngine here")
    }

    @PluginMethod
    fun complete(call: PluginCall) {
        call.reject("Attach llama.cpp Android token generation here")
    }

    @PluginMethod
    fun unload(call: PluginCall) {
        val result = JSObject()
        result.put("ok", true)
        call.resolve(result)
    }
}
